# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Your live site address (used for the share preview image, sitemap and SEO).
# Example: https://deofebrero.com   (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking emails. Create a free account at https://resend.com using dcifebrero@gmail.com,
# then create an API key and paste it here.
RESEND_API_KEY=

# Where booking requests are delivered.
BOOKING_TO_EMAIL=dcifebrero@gmail.com

# Optional. Leave as is until you verify your own domain in Resend.
# (With the default sender, Resend only delivers to the email you signed up with.)
BOOKING_FROM_EMAIL="PhewFlow Bookings <onboarding@resend.dev>"
